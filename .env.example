# Plex Spoiler Shield - Direct Metadata Modification Mode
# This service modifies Plex metadata directly (not a proxy).
# It runs a webhook listener and background poller to manage spoiler protection.

# Plex server URL (from inside Docker, use the service name or host.docker.internal)
PLEX_URL=http://plex:32400
# Your Plex authentication token (find it via https://support.plex.tv/articles/204059436/)
PLEX_TOKEN=your-plex-token-here
# Port the service listens on (for webhooks, health, and status endpoints)
PROXY_PORT=32401
# SQLite database path (inside the container)
DB_PATH=/data/watch_state.db
# Background poll interval in seconds (fallback sync)
POLL_INTERVAL=600
# Log level
LOG_LEVEL=info
# SSL (optional — leave empty to disable HTTPS)
SSL_CERTFILE=
SSL_KEYFILE=
