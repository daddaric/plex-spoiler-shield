# Plex server URL (from inside Docker, use host.docker.internal)
PLEX_URL=http://host.docker.internal:32400
# Your Plex authentication token (find it via https://support.plex.tv/articles/204059436/)
PLEX_TOKEN=your-plex-token-here
# Port the proxy listens on
PROXY_PORT=32401
# SQLite database path (inside the container)
DB_PATH=/data/watch_state.db
# Background poll interval in seconds (fallback sync)
POLL_INTERVAL=600
# Log level
LOG_LEVEL=info
# SSL (optional — leave empty to disable HTTPS)
SSL_CERTFILE=
SSL_KEYFILE=
# Example for self-signed certs:
# SSL_CERTFILE=/certs/cert.pem
# SSL_KEYFILE=/certs/key.pem
